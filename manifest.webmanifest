{
  "id": "./",
  "name": "Zımba — PDF Tools",
  "short_name": "Zımba",
  "description": "Merge, split, compress and organize PDFs on your computer. Images to PDF, PDF to images and page numbers. Free, offline and private.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F5F5F2",
  "theme_color": "#F5F5F2",
  "lang": "en",
  "dir": "ltr",
  "categories": ["productivity", "utilities", "business"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": { "application/pdf": [".pdf"] },
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "files", "accept": ["application/pdf", ".pdf", "image/*"] }] }
  }
}
